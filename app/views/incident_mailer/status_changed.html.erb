<h1><%= @incident.title %></h1>
<p><strong><%= @update.status.humanize %>:</strong> <%= @update.body %></p>
<p>Started: <%= l(@incident.started_at, format: :long) %> UTC<% if @incident.resolved? %> · Resolved: <%= l(@incident.resolved_at, format: :long) %> UTC<% end %></p>
<p><%= link_to "View status page", root_url %></p>
<p style="color:#888;font-size:12px"><%= link_to "Unsubscribe", unsubscribe_subscription_url(@subscriber.token) %></p>
